PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443
JELLYFIN_PORT=8096
MEDIA_DIR=./media
JELLYFIN_CONFIG_DIR=./jellyfin-config
JELLYFIN_CACHE_DIR=./jellyfin-cache
MARCOS_DASHBOARD_PORT=8080

# Autonomous Agent Protocol runtime state store (TASK-0003). Set a real
# password in docker/.env (gitignored) -- never commit a value here.
MARCOS_TASKS_DB_NAME=marcos_tasks
MARCOS_TASKS_DB_USER=marcos_tasks
MARCOS_TASKS_DB_PASSWORD=change-me
MARCOS_TASKS_DB_PORT=5433

# Vaultwarden (docs/VAULTWARDEN_ARCHITECTURE.md). Variable names only --
# real values go in docker/.env (gitignored), never here. Service is
# defined in docker-compose.vaultwarden.yml but intentionally not started;
# starting it, and choosing the real DOMAIN hostname, require explicit
# human approval (infrastructure + architecture decision, not autonomous).
VAULTWARDEN_DOMAIN=https://change-me.example.com
VAULTWARDEN_ADMIN_TOKEN=change-me-argon2id-hash
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_SMTP_HOST=change-me
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_FROM=change-me
VAULTWARDEN_SMTP_USERNAME=change-me
VAULTWARDEN_SMTP_PASSWORD=change-me
VAULTWARDEN_PORT=8422
VAULTWARDEN_DATA_DIR=./vaultwarden-data
